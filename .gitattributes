# Commit this file before/with the first project assets.
* text=auto
*.uproject text eol=lf
*.uplugin text eol=lf
*.modules text eol=lf
*.target text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal packages and sidecar payloads.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.uptnl filter=lfs diff=lfs merge=lfs -text

# Images, source art, geometry and interchange payloads.
