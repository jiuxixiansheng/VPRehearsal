# Shared project data is versioned: Config/, Content/, Source/, Build/,
# *.uproject, and plugin source, content, resources and runtime binaries.
# In GitHub Desktop choose Git ignore: None to keep these project rules.

# Rebuildable Unreal caches, autosaves, logs and generated files.
**/DerivedDataCache/
**/Intermediate/
**/Saved/
# Project executables can be rebuilt; bundled plugin binaries are retained.
/Binaries/

# IDE state and generated project files.
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.csproj.user

# Debug symbols and compiler scratch files are not needed to load plugins.
*.pdb
*.ilk
*.exp
# Keep .obj geometry; compiler object files live under ignored Intermediate/.
*.o
*.pch
*.ipch
*.gch

# Local Python/Node environments and generated bytecode.
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# Local environment overrides and temporary/backup files.
.env
.env.*
!.env.example
*.local.ini
*.log
*.tmp
*.temp
*.bak
*.backup
*~
.DS_Store
Thumbs.db
Desktop.ini
.git-metadata-empty/

# Share the project's localhost MCP endpoint, not personal Codex state.
/.codex/*
!/.codex/config.toml
